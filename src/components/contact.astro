---
import { site } from '../data/site'
import Button from './button.astro'
import Glow from './glow.astro'
import ArrowIcon from './arrow-icon.astro'

const { contacts } = site
---

<div id="contacts" class="px-frame pb-frame">
  <section
    class="relative isolate overflow-hidden rounded-block bg-page"
    style="--hue: var(--color-accent)"
  >
    <Glow size="lg" variant="aurora" />
    <div class="relative z-10 flex min-h-69 flex-col justify-between gap-10 p-inset sm:gap-16">
      <h2 class="eyebrow text-ink-muted" data-reveal>
        {contacts.label}
      </h2>
      <div class="flex flex-wrap items-center justify-between gap-6">
        <a
          href={`mailto:${contacts.email}`}
          class="inline-flex items-center gap-3 text-email tracking-title"
          data-reveal
        >
          {contacts.email}
          <ArrowIcon size={28} />
        </a>
        <div class="flex gap-2" data-reveal>
          {
            contacts.links.map((link) => (
              <Button href={link.href} external>
                {link.label}
              </Button>
            ))
          }
        </div>
      </div>
      <div
        class:list={[
          'flex flex-wrap items-center justify-between gap-x-6 gap-y-2',
          'border-t border-line pt-4 text-xs text-ink-muted',
        ]}
        data-reveal
      >
        <span>
          {site.name} / {site.role}
        </span>
        <a href="#top" class="transition-colors hover:text-ink"> Наверх ↑ </a>
      </div>
    </div>
  </section>
</div>
