---
type Variant = 'default' | 'primary'
type Size = 'sm' | 'md' | 'lg'
type Element = 'button' | 'a' | 'span'

interface Props {
  as?: Element
  variant?: Variant
  size?: Size
  disabled?: boolean
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const {
  as: Chip = 'span',
  variant = 'default',
  size = 'md',
  disabled = false,
  href,
  type = 'button',
  class: className,
  ...props
}: Props = Astro.props
---

<Chip
  class:list={['chip', `chip--${variant}`, `chip--${size}`, className]}
  href={Chip === 'a' ? href : undefined}
  type={Chip === 'button' ? type : undefined}
  disabled={Chip === 'button' ? disabled : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  {...props}
>
  <slot />
</Chip>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    font: inherit;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: default;
  }

  .chip--sm {
    height: 1.75rem;
    padding-inline: 0.5rem;
    font-size: 0.75rem;
  }
  .chip--md {
    height: 2rem;
    padding-inline: 0.75rem;
    font-size: 0.875rem;
  }
  .chip--lg {
    height: 2.625rem;
    padding-inline: 1.25rem;
    font-size: 1rem;
  }

  .chip--default {
    border: 1px solid var(--color-line-strong);
    background: var(--color-soft);
    color: var(--color-ink);
  }
  .chip--primary {
    background: var(--color-ink);
    color: var(--color-page);
    font-weight: 500;
  }

  button.chip,
  a.chip {
    cursor: pointer;
    transition: all 0.2s ease;
  }

  a.chip:hover,
  button.chip:hover {
    background: rgb(244 247 247 / 0.1);
  }

  .chip--primary:hover {
    background: rgb(244 247 247 / 0.85);
  }

  button.chip:disabled,
  .chip[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
