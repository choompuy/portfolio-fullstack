---
import Chip from './chip.astro'
---

<header class="flex items-center justify-between py-6">
  <!-- Logo -->
  <a href="/" class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-lg bg-(--text) flex items-center justify-center">
      <span class="text-(--bg) font-semibold text-sm">А</span>
    </div>
    <span class="text-base font-medium">Васильев Айхал</span>
  </a>

  <!-- Navigation -->
  <nav class="flex items-center gap-3">
    <Chip as="a" href="#projects" variant="default" size="pill">Проекты</Chip>
    <Chip as="a" href="#about" variant="default" size="pill">Обо мне</Chip>
    <Chip as="a" href="#skills" variant="default" size="pill">Навыки</Chip>
    <Chip as="a" href="#contact" variant="primary" size="pill">
      Связаться
      <span class="text-lg">↗</span>
    </Chip>
  </nav>
</header>
