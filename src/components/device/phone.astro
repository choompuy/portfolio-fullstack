---
import { IPHONE_RATIO, PHONE_BARS } from '../../lib/screen'
import Wall from './wall.astro'

interface Props {
  /** Цвет полосы над скриншотом */
  top?: string
  /** Цвет полосы под скриншотом */
  bottom?: string
  /** Телефон без скриншота: на весь экран приглушённые обои */
  empty?: boolean
}

const { top = '#000', bottom = '#000', empty = false } = Astro.props

// Размеры полос заданы в долях ширины экрана, в CSS их удобно брать через cqw
const sizes = `--ratio:${IPHONE_RATIO};--bar-top:${PHONE_BARS.top * 100}cqw;--bar-bottom:${PHONE_BARS.bottom * 100}cqw`
---

<div class="phone">
  <div class="body">
    <div class="bezel">
      <div
        class="screen"
        style={`${sizes};--top:${empty ? 'transparent' : top};--bottom:${empty ? 'transparent' : bottom}`}
      >
        {empty && <Wall />}
        <div class="status"><i class="island"></i></div>
        <div class="content"><slot /></div>
        <div class="home"><i class="indicator"></i></div>
        <i class="sheen"></i>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: 100%;
  }

  .body {
    position: relative;
    padding: 1cqw;
    border-radius: 15.5cqw;
    background: linear-gradient(145deg, #6a6b70 0%, #2a2b2f 28%, #17181a 55%, #4b4c51 100%);
    box-shadow: inset 0 0 0 0.15cqw rgb(255 255 255 / 0.12);
  }

  /* кнопки на торцах */
  .body::before,
  .body::after {
    content: '';
    position: absolute;
    width: 0.8cqw;
    border-radius: 0.4cqw;
    background: #3c3d42;
  }
  .body::before {
    right: -0.55cqw;
    top: 27cqw;
    height: 17cqw;
  }
  .body::after {
    left: -0.55cqw;
    top: 28cqw;
    height: 9cqw;
    box-shadow: 0 12cqw 0 0 #3c3d42;
  }

  .bezel {
    padding: 1.7cqw;
    border-radius: 14.5cqw;
    background: #050506;
  }

  /* Контейнер: внутри 1cqw равен одному проценту ширины экрана */
  .screen {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    border-radius: 11.5cqw;
    background: #000;
  }

  .status,
  .home {
    position: relative;
    flex: none;
  }

  .status {
    height: var(--bar-top);
    background: var(--top);
  }

  .home {
    height: var(--bar-bottom);
    background: var(--bottom);
  }

  .content {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .island {
    position: absolute;
    top: 3cqw;
    left: 50%;
    width: 26cqw;
    height: 7.2cqw;
    translate: -50% 0;
    border-radius: 9999px;
    background: #000;
  }

  .indicator {
    position: absolute;
    bottom: 1.6cqw;
    left: 50%;
    width: 34cqw;
    height: 1.2cqw;
    translate: -50% 0;
    border-radius: 9999px;
    background: rgb(150 150 150 / 0.8);
  }

  .sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(120deg, rgb(255 255 255 / 0.08), transparent 35%);
  }
</style>
