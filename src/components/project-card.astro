---
import type { Project } from '../types'
import Glow from './glow.astro'
import Chip from './chip.astro'
import GlassFrame from './glass-frame.astro'
import ArrowButton from './arrow-button.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
const wide = project.layout === 'wide'
---

<article>
  <div
    class="relative isolate h-105 overflow-hidden rounded-block bg-page"
    style={`--hue: ${project.hue}`}
  >
    <Glow />

    {
      wide ? (
        <>
          <div class="absolute left-6 top-6 z-10 max-w-[calc(100%-3rem)]">
            <ul class="flex flex-wrap gap-1.5">
              {project.stack.map((item) => (
                <Chip variant="default" size="sm">
                  {item}
                </Chip>
              ))}
            </ul>
          </div>
          {project.intro && (
            <div class="absolute left-6 top-[58%] z-10 w-[calc(100%-3rem)] max-w-105 -translate-y-1/2 md:left-12 md:top-1/2">
              <p class="text-[2.75rem] leading-none tracking-[-0.03em] md:text-[4rem]">
                {project.intro.title}
              </p>
              <p class="mt-6 text-[1.375rem] leading-[1.2] tracking-[-0.01em] md:text-[1.75rem]">
                {project.intro.lead}
              </p>
              <p class="mt-5 max-w-75 text-sm leading-snug text-ink-muted">{project.intro.text}</p>
            </div>
          )}
          <GlassFrame class="absolute right-14 top-1/2 z-10 hidden aspect-600/314 w-150 max-w-[48%] -translate-y-1/2 lg:block">
            <div class="grid h-full place-items-center text-xs text-ink-faint">
              Скриншот проекта
            </div>
          </GlassFrame>
          <div class="absolute inset-x-6 bottom-6 z-10 flex items-end justify-between">
            <span class="text-xs text-ink-muted">{project.year}</span>
            {project.note && <span class="text-xs text-ink-muted">{project.note}</span>}
          </div>
        </>
      ) : (
        <div class="relative z-10 flex h-full flex-col gap-5 p-6">
          <ul class="flex flex-wrap gap-1.5">
            {project.stack.map((item) => (
              <Chip variant="default" size="sm">
                {item}
              </Chip>
            ))}
          </ul>
          <GlassFrame class="relative min-h-0 flex-1">
            <div class="grid h-full place-items-center text-xs text-ink-faint">
              Скриншот проекта
            </div>
          </GlassFrame>
          <div class="flex items-end justify-between">
            <span class="text-xs text-ink-muted">{project.year}</span>
            {project.note && <span class="text-xs text-ink-muted">{project.note}</span>}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex items-start justify-between gap-5 pb-4 pt-5">
    <div class="min-w-0">
      <h3 class="text-case font-normal">{project.title}</h3>
      <p class={`mt-3 text-base leading-6 text-ink-muted ${wide ? 'max-w-275' : 'max-w-147'}`}>
        {project.description}
      </p>
    </div>
    <ArrowButton label={`Открыть проект ${project.title}`} href={project.href} />
  </div>
</article>
