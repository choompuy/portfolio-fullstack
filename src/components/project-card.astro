---
import type { Project } from '../types'
import Glow from './glow.astro'
import ChipList from './chip-list.astro'
import ArrowButton from './arrow-button.astro'
import Devices from './devices.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
const wide = project.layout === 'wide'
---

<article data-reveal="block">
  <div
    class="tilt relative isolate h-105 overflow-hidden rounded-block bg-page"
    style={`--hue: ${project.hue}`}
  >
    <Glow reveal="ignite" />

    {
      wide ? (
        <>
          <div class="absolute left-6 top-6 z-10 max-w-[calc(100%-3rem)]">
            <ChipList items={project.stack} />
          </div>
          {project.intro && (
            <div class="absolute left-6 top-[58%] z-10 w-[calc(100%-3rem)] max-w-105 -translate-y-1/2 md:left-12 md:top-1/2">
              <p class="text-[2.75rem] leading-none tracking-[-0.03em] md:text-[4rem]">
                {project.intro.title}
              </p>
              <p class="mt-6 text-[1.375rem] leading-[1.2] tracking-[-0.01em] md:text-[1.75rem]">
                {project.intro.lead}
              </p>
            </div>
          )}
          <div class="absolute bottom-10 right-10 top-12 z-10 hidden w-[42%] lg:block xl:w-[50%]">
            <Devices devices={project.devices} title={project.title} hue={project.hue} />
          </div>
          <div class="absolute inset-x-6 bottom-6 z-10 flex items-end justify-between">
            <span class="text-xs text-ink-muted">{project.year}</span>
            {project.note && <span class="text-xs text-ink-muted">{project.note}</span>}
          </div>
        </>
      ) : (
        <div class="relative z-10 flex h-full flex-col gap-5 p-6">
          <ChipList items={project.stack} />
          <div class="min-h-0 flex-1">
            <Devices devices={project.devices} title={project.title} hue={project.hue} />
          </div>
          <div class="flex items-end justify-between">
            <span class="text-xs text-ink-muted">{project.year}</span>
            {project.note && <span class="text-xs text-ink-muted">{project.note}</span>}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex items-start justify-between gap-5 pb-4 pt-5">
    <div class="flex min-w-0 flex-col gap-3">
      <h3 class={wide ? 'sr-only' : 'text-case font-normal'}>{project.title}</h3>
      <p class={`text-base leading-6 text-ink-muted ${wide ? 'max-w-275' : 'max-w-147'}`}>
        {project.description}
      </p>
    </div>
    <ArrowButton label={`Открыть проект ${project.title}`} href={project.demo ?? project.href} />
  </div>
</article>

<script>
  import { tilt } from '../scripts/tilt'

  tilt('.tilt')
</script>
