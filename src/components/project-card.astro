---
import type { Project } from '../types'
import Glow from './glow.astro'
import ChipList from './chip-list.astro'
import ArrowButton from './arrow-button.astro'
import Devices from './devices.astro'

interface Props {
  project: Project
  number: number
}

const { project, number } = Astro.props
const wide = project.layout === 'wide'
const link = project.demo ?? project.href
---

<article class="flex flex-col gap-5">
  <div
    class:list={[
      'tilt relative isolate overflow-hidden rounded-block bg-page',
      wide ? 'lg:h-105' : 'h-96 sm:h-105',
    ]}
    style={`--hue: ${project.hue}`}
  >
    <Glow reveal="ignite" />

    <div class="relative z-10 flex h-full flex-col gap-5 p-5 sm:p-6">
      <ChipList items={project.stack} />

      <!-- Широкая карточка. На lg: текст слева, устройства справа, оба поверх обложки.
           Ниже lg всё идёт друг за другом: чипы, текст, устройства, дата.
           Остальные карточки: устройства между чипами и датой -->
      {
        wide && project.intro && (
          <div
            class:list={[
              'flex flex-col gap-3',
              'lg:absolute lg:inset-x-12 lg:top-1/2 lg:max-w-105 lg:-translate-y-1/2 lg:gap-6',
            ]}
          >
            <p class="text-intro tracking-heading">{project.intro.title}</p>
            <p class="text-intro-lead tracking-lead">{project.intro.lead}</p>
          </div>
        )
      }
      <div
        class:list={wide
          ? [
              'h-56 shrink-0 sm:h-72',
              'lg:absolute lg:top-12 lg:right-10 lg:bottom-10 lg:h-auto lg:w-[42%] xl:w-[50%]',
            ]
          : 'min-h-0 flex-1'}
      >
        <Devices devices={project.devices} title={project.title} hue={project.hue} />
      </div>

      <div class="mt-auto flex items-end justify-between text-xs text-ink-muted">
        <span>{project.year}</span>
        <span class="tabular-nums">{String(number).padStart(2, '0')}</span>
      </div>
    </div>
  </div>

  <div class="flex items-start justify-between gap-5 pb-4">
    <div class="flex min-w-0 flex-col gap-3">
      <h3 class={wide ? 'sr-only' : 'text-case font-normal'}>{project.title}</h3>
      <p class={`text-base leading-6 text-ink-muted ${wide ? 'max-w-275' : 'max-w-147'}`}>
        {project.description}
      </p>
    </div>
    {link && <ArrowButton label={`Открыть проект ${project.title}`} href={link} />}
  </div>
</article>

<script>
  import { tilt } from '../scripts/tilt'

  tilt('.tilt')
</script>
