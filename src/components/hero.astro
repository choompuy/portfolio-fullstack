---
import { site } from '../data/site'
import Button from './button.astro'
import ChipList from './chip-list.astro'
import Glow from './glow.astro'
---

<div class="px-frame pt-frame" id="top">
  <section
    class="relative isolate overflow-hidden rounded-block bg-page"
    style="--hue: var(--color-accent)"
  >
    <Glow size="lg" drift variant="aurora" priority />
    <div class="relative z-10 flex min-h-152 flex-col gap-10 p-inset">
      <div class="h-11 shrink-0 sm:h-21 lg:h-25" aria-hidden="true"></div>

      <!-- Hero content -->
      <div class="flex flex-col gap-10">
        <div class="flex flex-col items-start gap-5">
          <p class="pill" data-intro="focus" data-step="3">
            <span aria-hidden="true" class="status-dot size-1.75 rounded-full bg-status"></span>
            {site.status}
          </p>
          <h1 class="w-fit text-display font-normal tracking-heading" data-ignite>
            {site.role}
          </h1>
        </div>
        <div class="flex max-w-140 flex-col items-start gap-10 lg:ml-[28%]">
          <p class="text-lg leading-snug" data-intro="emerge" data-step="4">{site.tagline}</p>
          <Button href="#projects" data-intro="focus" data-step="5">Смотреть проекты</Button>
        </div>
      </div>

      <!-- Tech card -->
      <aside
        class:list={[
          'flex flex-col gap-5 rounded-panel bg-card p-5',
          'lg:absolute lg:right-inset lg:bottom-inset lg:w-71',
        ]}
        data-intro="emerge"
        data-step="6"
      >
        <h2 class="eyebrow">{site.techCard.title}</h2>
        <ChipList items={site.techCard.chips} priority />
      </aside>
    </div>
  </section>
</div>
