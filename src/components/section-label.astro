---
interface Props {
  label: string
  count: string
}

const { label, count } = Astro.props
---

<div class="flex items-center justify-between border-b border-line pb-4" data-reveal>
  <span class="eyebrow text-ink-faint">{label}</span>
  <span class="text-sm text-ink-faint">{count}</span>
</div>
