---
import ArrowIcon from './arrow-icon.astro'

interface Props {
  variant?: 'primary' | 'ghost' | 'text'
  href?: string
  external?: boolean
  arrow?: boolean
  class?: string
}

const {
  variant = 'ghost',
  href = '#',
  external = false,
  arrow = true,
  class: className,
  ...props
}: Props = Astro.props

const variants = {
  primary: 'bg-ink text-page hover:bg-ink/85',
  ghost: 'border border-line-strong bg-soft hover:bg-ink/10',
  text: 'text-ink-muted hover:text-ink',
}

const arrowMotion =
  'transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5'
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  class:list={[
    'btn group/btn',
    variants[variant],
    className,
  ]}
  {...props}
>
  <slot />
  {
    arrow && (
      <ArrowIcon class={arrowMotion} />
    )
  }
</a>
