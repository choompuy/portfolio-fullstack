---
import ArrowIcon from './arrow-icon.astro'

interface Props {
  label: string
  href: string
}

const { label, href } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  aria-label={label}
  class:list={[
    'grid size-12 shrink-0 place-items-center rounded-full border border-line-strong',
    'transition-colors duration-200 hover:bg-ink hover:text-page',
  ]}
>
  <ArrowIcon />
</a>
