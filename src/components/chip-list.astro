---
interface Props {
  items: string[]
  size?: 'sm' | 'md'
  priority?: boolean
  class?: string
}

const { items, size = 'sm', priority = false, class: className } = Astro.props

const sizes = {
  sm: 'h-7 px-2 text-xs',
  md: 'h-8 px-3 text-sm',
}
---

<ul
  class:list={['flex flex-wrap gap-1.5', className]}
  data-chips
  data-chips-priority={priority ? '' : undefined}
>
  {
    items.map((item, i) => (
      <li
        class={`chip ${sizes[size]}`}
        style={`--i:${i}`}
      >
        {item}
      </li>
    ))
  }
</ul>
