---
import Chip from './chip.astro'

interface Props {
  items: string[]
  size?: 'sm' | 'md'
  class?: string
}

const { items, size = 'sm', class: className } = Astro.props
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {
    items.map((item) => (
      <li>
        <Chip size={size}>{item}</Chip>
      </li>
    ))
  }
</ul>
