---
interface Props {
  items: string[]
  size?: 'sm' | 'md'
  class?: string
}

const { items, size = 'sm', class: className } = Astro.props

const sizes = {
  sm: 'h-7 px-2 text-xs',
  md: 'h-8 px-3 text-sm',
}
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {
    items.map((item) => (
      <li
        class={`inline-flex items-center rounded-full border border-line-strong bg-soft leading-none whitespace-nowrap ${sizes[size]}`}
      >
        {item}
      </li>
    ))
  }
</ul>
