---
import { site } from '../data/site'
import { skills } from '../data/skills'
import Container from './container.astro'
import ChipList from './chip-list.astro'
---

<section id="skills" class="py-section">
  <Container>
    <div class="grid gap-8 sm:gap-12 lg:grid-cols-12 lg:gap-x-6">
      <div class="lg:col-span-4">
        <h2 class="text-section font-normal tracking-title" data-reveal-words="ignite">
          {site.skills.titleLines.map((line) => <span class="block">{line}</span>)}
        </h2>
      </div>
      <ul class="flex flex-col gap-6 divide-y divide-line lg:col-span-8">
        {
          skills.map((group) => (
            <li class="flex flex-col gap-4 pb-6 last:pb-0">
              <h3 class="text-case font-normal" data-reveal>{group.name}</h3>
              <ChipList items={group.items} size="md" />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
