---
import { nav, site } from '../data/site'
import Button from './button.astro'
---

<!-- Пока этот сторож виден, шапка остаётся на обложке -->
<span
  id="header-sentinel"
  class="pointer-events-none absolute top-0 left-0 h-20 w-px"
  aria-hidden="true"></span>

<header
  id="site-header"
  data-state="top"
  class="header fixed z-50 mx-auto flex items-center justify-between rounded-full border border-transparent"
>
  <Button href="#top" variant="text" arrow={false} class="brand" data-intro="focus" data-step="1">
    {site.name}
  </Button>
  <nav
    aria-label="Основная навигация"
    class="absolute left-1/2 hidden -translate-x-1/2 gap-2 md:flex"
    data-intro="focus"
    data-step="1"
  >
    {
      nav.map((item) => (
        <Button href={item.href} arrow={false}>
          {item.label}
        </Button>
      ))
    }
  </nav>
  <Button href="#contacts" variant="primary" data-intro="focus" data-step="2">Связаться</Button>
</header>

<script>
  import { siteHeader } from '../scripts/site-header'

  siteHeader('#site-header', '#header-sentinel')
</script>

<style>
  /* На обложке: на ширину обложки, без фона. Отступы те же, что у hero: поле frame плюс отступ inset */
  .header {
    top: calc(var(--spacing-frame) + var(--spacing-inset));
    inset-inline: calc(var(--spacing-frame) + var(--spacing-inset));
    max-width: 100%;
    gap: 1rem;
    background-color: transparent;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0);
    backdrop-filter: blur(0);
  }

  .header :global(.brand) {
    padding-inline: 0;
  }

  /* Плашка: узкая, по центру, с фоном и размытием */
  .header[data-state='docked'] {
    top: 0.75rem;
    inset-inline: 1rem;
    max-width: 52rem;
    gap: 1.5rem;
    padding: 0.375rem 0.375rem 0.375rem 0.5rem;
    border-color: var(--color-line-strong);
    background-color: color-mix(in srgb, var(--color-page) 70%, transparent);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.45);
    backdrop-filter: blur(1.25rem);
  }

  .header[data-state='docked'] :global(.brand) {
    padding-inline: 1.5rem 0;
  }

  /* Переходы включает data-ready, чтобы шапка не анимировалась при загрузке страницы */
  .header[data-ready] {
    transition-property:
      top, inset-inline, max-width, gap, padding, background-color, border-color, box-shadow,
      backdrop-filter;
    transition-duration: 0.6s;
    transition-timing-function: var(--ease-out);
  }

  .header[data-ready] :global(.brand) {
    transition:
      padding-inline 0.6s var(--ease-out),
      color 0.2s;
  }
</style>
