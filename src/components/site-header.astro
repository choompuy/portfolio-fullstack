---
import { nav, site } from '../data/site'
import Button from './button.astro'
import NavPill from './nav-pill.astro'
---

<!-- Пока этот сторож виден, шапка остаётся на обложке -->
<span
  id="header-sentinel"
  class="pointer-events-none absolute left-0 top-0 h-20 w-px"
  aria-hidden="true"
>
</span>

<header
  id="site-header"
  data-state="top"
  class="group/header pointer-events-none fixed inset-x-0 top-0 z-50 px-14 pt-14 data-ready:transition-[padding] data-ready:duration-600 data-ready:ease-out data-[state=docked]:px-4 data-[state=docked]:pt-3"
>
  <div
    class="pointer-events-auto relative mx-auto flex max-w-full items-center justify-between gap-4 rounded-full border border-transparent bg-page/0 shadow-[0_1rem_2.5rem_rgb(0_0_0/0)] backdrop-blur-none group-data-ready/header:transition-[max-width,padding,gap,background-color,border-color,box-shadow,backdrop-filter] group-data-ready/header:duration-600 group-data-ready/header:ease-out group-data-[state=docked]/header:max-w-208 group-data-[state=docked]/header:gap-6 group-data-[state=docked]/header:border-line-strong group-data-[state=docked]/header:bg-page/70 group-data-[state=docked]/header:p-1.5 group-data-[state=docked]/header:pl-2 group-data-[state=docked]/header:shadow-[0_1rem_2.5rem_rgb(0_0_0/0.45)] group-data-[state=docked]/header:backdrop-blur-xl"
  >
    <Button
      href="#top"
      variant="text"
      class="group-data-[state=top]/header:px-0! group-data-[state=docked]/header:max-sm:hidden group-data-ready/header:transition-[max-width,opacity] group-data-ready/header:duration-600 group-data-ready/header:ease-out group-data-[state=docked]/header:max-sm:max-w-0 group-data-[state=docked]/header:max-sm:opacity-0"
      data-in="drop"
      data-step="1"
      arrow={false}
    >
      {site.name}
    </Button>
    <nav
      aria-label="Основная навигация"
      class="absolute left-1/2 hidden -translate-x-1/2 gap-2 md:flex"
      data-in="drop"
      data-step="1"
    >
      {nav.map((item) => <NavPill href={item.href}>{item.label}</NavPill>)}
    </nav>
    <Button href="#contacts" variant="primary" data-in="drop" data-step="2">Связаться</Button>
  </div>
</header>

<script>
  import { siteHeader } from '../scripts/site-header'

  siteHeader('#site-header', '#header-sentinel')
</script>
