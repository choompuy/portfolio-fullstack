---
import type { Devices } from '../types'
import { resolveScreen } from '../lib/screen'
import Mac from './device/mac.astro'
import Phone from './device/phone.astro'
import Screen from './device/screen.astro'

interface Props {
  devices: Devices
  title: string
  hue: string
}

const { devices, title, hue } = Astro.props
const phones = devices.phones ?? []

const kind = devices.mac
  ? phones.length
    ? 'mac-phone'
    : 'mac'
  : (['phone', 'phone', 'phones2', 'phones3'][phones.length] ?? 'phones3')

const mac = devices.mac ? await resolveScreen(devices.mac) : undefined
const phoneScreens = await Promise.all(phones.map((p) => resolveScreen(p)))

const macSizes = '(min-width: 64rem) 32.5rem, 90vw'
const phoneSizes = '12.5rem'
const alt = `Экран проекта ${title}`
---

<div class="stage" style={`--hue:${hue}`}>
  <div class={`rig rig--${kind}`}>
    {
      mac && (
        <div class="slot slot-mac">
          <div class="layer">
            <Mac>
              <Screen screen={mac} alt={alt} sizes={macSizes} widths={[640, 1280]} />
            </Mac>
          </div>
        </div>
      )
    }
    {
      phoneScreens.map((screen, i) => (
        <div class={`slot slot-phone slot-phone-${i}`}>
          <div class="layer layer--deep">
            <Phone
              empty={screen.kind === 'empty'}
              top={phones[i].bar?.top}
              bottom={phones[i].bar?.bottom}
            >
              {screen.kind !== 'empty' && (
                <Screen screen={screen} alt={alt} sizes={phoneSizes} widths={[240, 480, 720]} />
              )}
            </Phone>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Сцена занимает всё место, которое дала карточка. Устройства вписываются в неё
     целиком и с нетронутыми пропорциями: ширина рамки считается из высоты сцены. */
  .stage {
    container-type: size;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .rig {
    position: relative;
    width: min(100cqw, calc(100cqh * var(--ar)));
    aspect-ratio: var(--ar);
  }

  .slot {
    position: absolute;
  }

  /* Параллакс от скрипта tilt.ts: --x и --y приходят от карточки, телефоны сдвигаются глубже */
  .layer {
    transform: translate(calc(var(--x, 0) * -0.875rem), calc(var(--y, 0) * -0.625rem));
    transition: transform 0.35s var(--ease-out);
    filter: drop-shadow(0 1.25rem 1.75rem rgb(0 0 0 / 0.45));
  }
  .layer--deep {
    transform: translate(calc(var(--x, 0) * -1.625rem), calc(var(--y, 0) * -1.125rem));
  }

  /* MacBook */
  .rig--mac {
    --ar: 1.5;
  }
  .rig--mac .slot-mac {
    inset: 0 0 auto 0;
  }

  /* MacBook и iPhone рядом: телефон стоит перед правым краем ноутбука */
  .rig--mac-phone {
    --ar: 1.4;
  }
  .rig--mac-phone .slot-mac {
    left: 0;
    top: 0;
    width: 80%;
  }
  .rig--mac-phone .slot-phone {
    right: 0;
    bottom: 0;
    width: 26%;
  }

  /* Один iPhone */
  .rig--phone {
    --ar: 0.47;
  }
  .rig--phone .slot-phone {
    inset: 0 auto auto 0;
    width: 100%;
  }

  /* Два iPhone со смещением по высоте */
  .rig--phones2 {
    --ar: 0.98;
  }
  .rig--phones2 .slot-phone {
    width: 42%;
  }
  .rig--phones2 .slot-phone-0 {
    left: 6%;
    bottom: 0;
  }
  .rig--phones2 .slot-phone-1 {
    right: 6%;
    top: 0;
  }

  /* Три iPhone веером: центральный крупнее и впереди */
  .rig--phones3 {
    --ar: 1.15;
  }
  .rig--phones3 .slot-phone {
    width: 34%;
    top: 8%;
  }
  .rig--phones3 .slot-phone-0 {
    left: 0;
  }
  .rig--phones3 .slot-phone-2 {
    right: 0;
  }
  .rig--phones3 .slot-phone-1 {
    left: 30%;
    width: 40%;
    top: 0;
    z-index: 2;
  }
  .rig--phones3 .slot-phone-0 .layer,
  .rig--phones3 .slot-phone-2 .layer {
    filter: brightness(0.8) drop-shadow(0 1rem 1.5rem rgb(0 0 0 / 0.4));
  }
</style>
