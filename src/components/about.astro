---
import { site } from '../data/site'
import Container from './container.astro'

const { about } = site
---

<section id="about" class="py-section">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-6">
      <h2 class="eyebrow text-ink-faint lg:col-span-3" data-reveal>
        {about.label}
      </h2>
      <div class="flex flex-col gap-10 sm:gap-14 lg:col-span-9">
        <p class="max-w-225 text-lead font-normal" data-reveal-words>
          <span>{about.leadBase}</span>
          <span class="text-accent">{about.leadAccent}</span>
        </p>
        <dl class="flex flex-wrap gap-x-10 gap-y-6 sm:gap-x-16 sm:gap-y-8" data-reveal-group>
          {
            about.metrics.map((metric) => (
              <div class="flex flex-col-reverse gap-2" data-reveal>
                <dd class="text-[13px] text-ink-muted">{metric.caption}</dd>
                <dt class="text-metric tracking-heading">{metric.value}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Container>
</section>
