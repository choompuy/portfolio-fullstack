---
import { site } from '../data/site'
import Container from './container.astro'

const { about } = site
---

<section id="about" class="py-section">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-6">
      <h2 class="eyebrow text-ink-faint lg:col-span-3" data-reveal>
        {about.label}
      </h2>
      <div class="flex flex-col gap-10 sm:gap-14 lg:col-span-9">
        <p class="max-w-225 text-lead font-normal" data-reveal-words>
          <span>{about.leadBase}</span>
          <span class="text-accent">{about.leadAccent}</span>
        </p>
        <ol class="grid gap-8 lg:grid-cols-3 lg:gap-6" data-reveal-group>
          {
            about.layers.map((layer, i) => (
              <li class="flex flex-col gap-4 border-t border-line pt-5" data-reveal>
                <span class="text-xs tabular-nums text-ink-faint">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="text-case font-normal">{layer.title}</h3>
                <p class="flex-1 text-[15px] leading-relaxed text-ink-muted">{layer.text}</p>
                <p class="text-xs text-ink-faint">{layer.projects.join(' · ')}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Container>
</section>
