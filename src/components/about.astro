---
import { site } from '../data/site'
import Container from './container.astro'

const { about } = site
---

<section id="about" class="py-28">
  <Container>
    <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-6">
      <h2
        class="text-xs font-medium uppercase tracking-[0.08em] text-ink-faint lg:col-span-3"
        data-reveal
      >
        {about.label}
      </h2>
      <div class="lg:col-span-9">
        <p class="max-w-225 text-lead font-normal" data-reveal-words>
          <span>{about.leadBase}</span>
          <span class="text-accent">{about.leadAccent}</span>
        </p>
        <p class="mt-10 max-w-130 text-[15px] leading-relaxed" data-reveal>{about.text}</p>
        <dl class="mt-14" data-reveal-group>
          {
            about.facts.map((fact) => (
              <div
                class="grid gap-1 first:border-t border-b border-line py-4 sm:grid-cols-[11rem_1fr] sm:gap-6"
                data-reveal
              >
                <dt class="text-[13px] text-ink-muted">{fact.label}</dt>
                <dd class="text-[15px]">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <dl class="mt-10 flex flex-wrap gap-x-16 gap-y-8" data-reveal-group>
          {
            about.metrics.map((metric) => (
              <div class="flex flex-col-reverse gap-2" data-reveal>
                <dd class="text-[13px] text-ink-muted">{metric.caption}</dd>
                <dt class="text-metric tracking-[-0.03em]">{metric.value}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Container>
</section>
